# Default path: local Ollama. No API key required.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
# Context window sent to Ollama. The samples fit well inside 8192.
OLLAMA_NUM_CTX=8192

# ollama (default) or openai (any OpenAI-compatible /chat/completions server).
FIT_SCORE_PROVIDER=ollama

# Seconds to wait for each model call.
FIT_SCORE_TIMEOUT=120

# Optional OpenAI-compatible path. Used only when FIT_SCORE_PROVIDER=openai.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
